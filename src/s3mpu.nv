// s3mpu.nv — a multipart upload as a state machine the caller drives.
//
// `[]` THROUGHOUT.  The upload holds no socket and no file; it holds
// part numbers, ETags and a plan.  The caller does the sending, which
// is what makes a resumable upload across a process restart a matter of
// storing this value rather than reimplementing the protocol.
//
// `S3MpuStep` IS THE LOAD-BEARING TYPE OF THIS MODULE, AND ITS
// IMPORTANT VARIANT IS `S3MpuMustAbort`.  A multipart upload that is
// neither completed nor aborted leaves its parts in the bucket
// FOREVER — they do not appear in a listing, they are not reachable by
// any key, and they are billed.  Every real S3 deployment has a
// lifecycle rule to sweep them precisely because every real client
// leaks them.  So the state machine cannot reach a terminal failure
// without saying, in the value it hands back, that an abort is owed;
// `upload_id_of` is public so the caller can store it and abort after a
// crash; and `abort` sits directly beside `complete` in this file
// rather than three screens away.
//
// THE PART PLAN IS COMPUTED BEFORE ANYTHING IS SENT, and that is the
// other reason this module exists.  Every part but the last must be at
// least five mebibytes; a part below the floor is accepted at upload
// time and refused at COMPLETE, with `EntityTooSmall`, after every byte
// has been uploaded and paid for.  `plan_parts` answers the sizes up
// front, `part_size_ok` is the predicate on its own, and a caller that
// picks its own sizes gets `S3FaultPartTooSmall` before a request is
// built rather than from the service an hour later.

use std.list
use std.str
use s3cfg
use s3fault
use s3op
use s3req
use s3xml

// The largest number of parts one upload may have.
pub const S3_MAX_PARTS = 10000

// The largest a single part may be: five gibibytes.
pub const S3_PART_MAX_BYTES = 5368709120

// The largest object a multipart upload can produce: five tebibytes.
pub const S3_OBJECT_MAX_BYTES = 5497558138880

// Where an upload is.
pub enum S3MpuState
    // Nothing has been initiated.  `initiate` is the only move.
    S3MpuFresh
    // An upload id exists and parts may be sent.
    S3MpuOpen
    // Every planned part has an ETag; `complete` is the move.
    S3MpuFull
    // Completed.  Terminal.
    S3MpuDone
    // Aborted.  Terminal, and the only terminal state that leaks
    // nothing.
    S3MpuAborted

// What the caller does next.
pub enum S3MpuStep
    // Send this request, then hand the reply to `supply_start`.
    S3MpuSendInitiate(request: S3Request)
    // Send this request with the bytes of part `number`, then hand the
    // reply to `supply_part`.
    S3MpuSendPart(number: Int, offset: Int, length: Int, request: S3Request)
    // Send this request, then hand the reply to `supply_complete`.
    S3MpuSendComplete(request: S3Request)
    // Finished.
    S3MpuFinished(result: S3UploadDone)
    // Something failed AND THERE ARE PARTS IN THE BUCKET.  The request
    // is the abort; sending it is not optional, and a caller that drops
    // this value on the floor has leaked storage that nothing will
    // report.
    S3MpuMustAbort(fault: S3Fault, request: S3Request)
    // Something failed before any part was stored, so there is nothing
    // to clean up.
    S3MpuFailed(fault: S3Fault)

// One planned part.
pub struct S3MpuPart
    // One-based.  S3 numbers parts from 1.
    number: Int
    offset: Int
    length: Int
    // Empty until the part has been uploaded.
    etag: Str

// A multipart upload in progress.
pub struct S3Mpu
    bucket: Str
    key: Str
    // Empty until `initiate` has been answered.
    upload_id: Str
    state: S3MpuState
    total: Int
    parts: [S3MpuPart]
    // How many parts carry an ETag.
    uploaded: Int
    // The failure `fail` recorded, which `step` turns into a terminal
    // step.  A field because the value that carries the failure is the
    // upload itself: `fail` answers an `S3Mpu`.
    failure: ?S3Fault
    // What the service answered to the completion.  A field because
    // `supply_complete` answers the document and not the upload, and a
    // pump that drops it has finished an upload and lost its ETag.
    outcome: ?S3UploadDone

// The fault for an object past the five-tebibyte ceiling, spelled as
// the code the service would answer with.  Refused before a byte is
// sent.
fn too_large(total: Int) -> S3Fault
    S3FaultService(400, S3ErrorDoc { code: S3EntityTooLarge,
                                     message: "an object of ${total} bytes exceeds the multipart ceiling",
                                     resource: "", request_id: "", host_id: "" })

// The fault for an upload id the service no longer holds.
fn no_upload(why: Str) -> S3Fault
    S3FaultService(404, S3ErrorDoc { code: S3NoSuchUpload, message: why, resource: "",
                                     request_id: "", host_id: "" })

fn find_part(parts: [S3MpuPart], number: Int) -> ?S3MpuPart
    var found: ?S3MpuPart = None
    for p in parts
        if p.number == number
            found = Some(p)
    found

fn with_etag(parts: [S3MpuPart], number: Int, etag: Str) -> [S3MpuPart]
    var out: [S3MpuPart] = []
    for p in parts
        if p.number == number
            out = list.concat(out, [S3MpuPart { number: p.number, offset: p.offset, length: p.length, etag: etag }])
        else
            out = list.concat(out, [p])
    out

fn count_etags(parts: [S3MpuPart]) -> Int
    var n = 0
    for p in parts
        if p.etag != ""
            n = n + 1
    n

// An open upload with every part stored is a full one.
fn settled(u: S3Mpu) -> S3Mpu
    if u.uploaded == list.len(u.parts)
        S3Mpu { bucket: u.bucket, key: u.key, upload_id: u.upload_id, state: S3MpuFull,
                total: u.total, parts: u.parts, uploaded: u.uploaded, failure: u.failure,
                outcome: u.outcome }
    else
        u

// The request for the first part with no ETag.
fn next_part(u: S3Mpu) -> S3MpuStep
    var pending: ?S3MpuPart = None
    for p in u.parts
        if pending == None and p.etag == ""
            pending = Some(p)
    match pending
        None    => S3MpuFailed(no_upload("the upload has no part left to send"))
        Some(p) =>
            let r = s3req.with_body(
                s3req.with_query(s3req.with_query(s3req.request("PUT", u.bucket, u.key),
                                                  "partNumber", str.from_int(p.number)),
                                 "uploadId", u.upload_id),
                S3BodyStreamedUnhashed(p.length))
            S3MpuSendPart(p.number, p.offset, p.length, r)

// Whether a size is legal for a part that is not the last.
//
// ```novo
// use s3mpu
//
// fn ok(n: Int) -> Bool
//     s3mpu.part_size_ok(n)
// ```
pub fn part_size_ok(size: Int) -> Bool []
    size >= s3op.S3_PART_MIN_BYTES and size <= S3_PART_MAX_BYTES

// The part sizes for an object of `total` bytes at a preferred size.
//
// Answers the plan, or the fault that says the plan is impossible:
// below the floor, above the ceiling, or more than ten thousand parts.
// The last part is whatever is left and may be any size at all,
// including one byte.
//
// THE PREFERRED SIZE IS RAISED RATHER THAN THE PART COUNT EXCEEDED.  An
// eight-hundred-gibibyte object at an eight-mebibyte part size is a
// hundred thousand parts, which is ten times the limit; answering a
// fault there would be correct and useless, so the plan raises the part
// size to the smallest one that fits and the caller can see what it
// became.
//
// ```novo
// use s3fault
// use s3mpu
//
// fn plan(n: Int) -> Result<[S3MpuPart], S3Fault>
//     s3mpu.plan_parts(n, 8388608)
// ```
pub fn plan_parts(total: Int, preferred: Int) -> Result<[S3MpuPart], S3Fault> []
    match planned_part_size(total, preferred)
        Err(f)   => Err(f)
        Ok(size) =>
            var parts: [S3MpuPart] = []
            var offset = 0
            var number = 1
            while offset < total
                let length = if total - offset < size
                    total - offset
                else
                    size
                parts = list.concat(parts, [S3MpuPart { number: number, offset: offset, length: length, etag: "" }])
                offset = offset + length
                number = number + 1
            Ok(parts)

// The part size `plan_parts` would use.
pub fn planned_part_size(total: Int, preferred: Int) -> Result<Int, S3Fault> []
    if total < 1
        Err(S3FaultPartTooSmall(1, total))
    else if total > S3_OBJECT_MAX_BYTES
        Err(too_large(total))
    else if preferred < s3op.S3_PART_MIN_BYTES
        Err(S3FaultPartTooSmall(1, preferred))
    else
        let wanted = if preferred > S3_PART_MAX_BYTES
            S3_PART_MAX_BYTES
        else
            preferred
        let needed = (total + S3_MAX_PARTS - 1) / S3_MAX_PARTS
        if needed <= wanted
            Ok(wanted)
        else
            // Whole mebibytes, so the part size a caller sees is a round one.
            Ok((needed + 1048575) / 1048576 * 1048576)

// Whether an object of this size needs a multipart upload at all.
//
// Below five gibibytes a single PUT is one round trip and no cleanup
// liability, and a client that used multipart for everything pays both
// for a file of four kilobytes.
pub fn needs_multipart(total: Int) -> Bool []
    total > s3op.S3_PUT_MAX_BYTES

// A fresh upload for an object of `total` bytes.
pub fn upload(bucket: Str, key: Str, total: Int, preferred_part: Int) -> Result<S3Mpu, S3Fault> []
    if not s3cfg.key_ok(key)
        Err(S3FaultBadKey(key))
    else
        match plan_parts(total, preferred_part)
            Err(f)    => Err(f)
            Ok(parts) =>
                Ok(S3Mpu { bucket: bucket, key: key, upload_id: "", state: S3MpuFresh, total: total,
                           parts: parts, uploaded: 0, failure: None, outcome: None })

// An upload resumed from an id and the parts a `ListParts` reported.
//
// The case that makes the whole design worth having: a process that
// died after eight hundred parts can pick the upload up from its id
// rather than sending eight hundred parts again.
pub fn resume(bucket: Str, key: Str, upload_id: Str, total: Int, preferred_part: Int,
              known: [S3PartInfo]) -> Result<S3Mpu, S3Fault> []
    if upload_id == ""
        Err(S3FaultBadXml("a resumed upload needs its upload id"))
    else
        match upload(bucket, key, total, preferred_part)
            Err(f) => Err(f)
            Ok(u)  =>
                var parts = list.clone(u.parts)
                var bad: ?S3Fault = None
                for k in known
                    match find_part(parts, k.part_number)
                        None    =>
                            bad = Some(S3FaultBadXml("ListParts named part ${k.part_number}, which the plan does not have"))
                        Some(p) =>
                            if p.length != k.size
                                bad = Some(S3FaultBadXml("ListParts says part ${k.part_number} is ${k.size} bytes and the plan says ${p.length}"))
                            else
                                parts = with_etag(parts, k.part_number, k.etag)
                match bad
                    Some(f) => Err(f)
                    None    => Ok(settled(S3Mpu { bucket: bucket, key: key, upload_id: upload_id,
                                               state: S3MpuOpen, total: total, parts: parts,
                                               uploaded: count_etags(parts), failure: None,
                                               outcome: None }))

// What to do next.
//
// The pump.  Called after every `supply_*`, and the value it answers is
// the whole of the caller's instruction.
//
// ```novo
// use s3mpu
//
// fn next(u: S3Mpu) -> S3MpuStep
//     s3mpu.step(u)
// ```
pub fn step(u: S3Mpu) -> S3MpuStep []
    match u.failure
        Some(f) =>
            if owes_abort(u)
                S3MpuMustAbort(f, abort_request(u.bucket, u.key, u.upload_id))
            else
                S3MpuFailed(f)
        None    =>
            match u.state
                S3MpuFresh   =>
                    let r = s3req.with_header(s3req.with_query(s3req.request("POST", u.bucket, u.key), "uploads", ""),
                                              "Content-Type", s3req.content_type_for(u.key))
                    S3MpuSendInitiate(r)
                S3MpuOpen    => next_part(u)
                S3MpuFull    =>
                    match completion(u)
                        Err(f)   => S3MpuMustAbort(f, abort_request(u.bucket, u.key, u.upload_id))
                        Ok(done) =>
                            let r = s3req.with_bytes(s3req.with_query(s3req.request("POST", u.bucket, u.key),
                                                                      "uploadId", u.upload_id),
                                                     s3xml.write_completion(done))
                            S3MpuSendComplete(r)
                S3MpuDone    =>
                    match u.outcome
                        Some(done) => S3MpuFinished(done)
                        None       => S3MpuFinished(S3UploadDone { location: "", bucket: u.bucket, key: u.key, etag: "" })
                S3MpuAborted => S3MpuFailed(no_upload("the upload was aborted"))

// Hand back the reply to `S3MpuSendInitiate`.
pub fn supply_start(u: S3Mpu, r: S3Reply) -> Result<S3Mpu, S3Fault> []
    if u.state != S3MpuFresh
        Err(S3FaultBadXml("the upload was already initiated"))
    else if r.status < 200 or r.status > 299
        Err(s3op.fault_of_reply(r))
    else
        match s3xml.upload_start(r.body)
            Err(f)    => Err(f)
            Ok(start) =>
                Ok(S3Mpu { bucket: u.bucket, key: u.key, upload_id: start.upload_id, state: S3MpuOpen,
                           total: u.total, parts: u.parts, uploaded: u.uploaded, failure: u.failure,
                           outcome: u.outcome })

// Hand back the reply to `S3MpuSendPart`.
//
// The ETag is read out of the reply and stored; a part whose reply
// carried no ETag is a part the service did not keep, however friendly
// its status was.
pub fn supply_part(u: S3Mpu, number: Int, r: S3Reply) -> Result<S3Mpu, S3Fault> []
    if r.status < 200 or r.status > 299
        Err(s3op.fault_of_reply(r))
    else
        match find_part(u.parts, number)
            None    => Err(S3FaultPartOutOfOrder(number, 0))
            Some(_) =>
                match s3req.header_of(r.headers, "etag")
                    None       => Err(S3FaultBadXml("the reply to part ${number} carried no ETag"))
                    Some(etag) =>
                        let parts = with_etag(u.parts, number, etag)
                        Ok(settled(S3Mpu { bucket: u.bucket, key: u.key, upload_id: u.upload_id,
                                           state: S3MpuOpen, total: u.total, parts: parts,
                                           uploaded: count_etags(parts), failure: u.failure,
                                           outcome: u.outcome }))

// Hand back the reply to `S3MpuSendComplete`.
//
// Checks the body and not only the status: a completion answers 200
// and then streams whitespace while it works, and the failure arrives
// inside that body.
pub fn supply_complete(u: S3Mpu, r: S3Reply) -> Result<S3UploadDone, S3Fault> []
    if r.status < 200 or r.status > 299
        Err(s3op.fault_of_reply(r))
    else
        s3xml.upload_done(r.body)

// Record an out-of-band failure and move to the state that owes an
// abort.
//
// What a caller calls when its own side failed — the file could not be
// read, the process is shutting down — so that `step` answers
// `S3MpuMustAbort` rather than the caller having to know that it should
// abort.
pub fn fail(u: S3Mpu, f: S3Fault) -> S3Mpu []
    S3Mpu { bucket: u.bucket, key: u.key, upload_id: u.upload_id, state: u.state, total: u.total,
            parts: u.parts, uploaded: u.uploaded, failure: Some(f), outcome: u.outcome }

// The abort request for an upload, whatever state it is in.
//
// Also the call a caller makes with nothing but an upload id, after a
// crash, with no `S3Mpu` at all — which is why `abort_request` takes
// the three strings rather than the value.
pub fn abort(u: S3Mpu) -> Result<S3Request, S3Fault> []
    if u.upload_id == ""
        Err(no_upload("nothing was initiated, so there is nothing to abort"))
    else
        Ok(abort_request(u.bucket, u.key, u.upload_id))

// The abort request from an upload id alone.
//
// ```novo
// use s3mpu
//
// fn cleanup(b: Str, k: Str, id: Str) -> S3Request
//     s3mpu.abort_request(b, k, id)
// ```
pub fn abort_request(bucket: Str, key: Str, upload_id: Str) -> S3Request []
    s3req.with_query(s3req.request("DELETE", bucket, key), "uploadId", upload_id)

// A request that lists the parts already uploaded, for a resume.
pub fn list_parts_request(bucket: Str, key: Str, upload_id: Str, after: Int) -> S3Request []
    let r = s3req.with_query(s3req.request("GET", bucket, key), "uploadId", upload_id)
    if after > 0
        s3req.with_query(r, "part-number-marker", str.from_int(after))
    else
        r

// A request that lists the unfinished uploads in a bucket.
//
// The operation an operator runs to find what every client has leaked,
// and the reason a library should publish it rather than leave it to
// the console.
pub fn list_uploads_request(bucket: Str, prefix: Str) -> S3Request []
    let r = s3req.with_query(s3req.request("GET", bucket, ""), "uploads", "")
    if prefix != ""
        s3req.with_query(r, "prefix", prefix)
    else
        r

// The upload id, for a caller storing it across a restart.
pub fn upload_id_of(u: S3Mpu) -> Str []
    u.upload_id

// Where the upload is.
pub fn state_of(u: S3Mpu) -> S3MpuState []
    u.state

// The plan, for a caller reading its own file.
pub fn parts_of(u: S3Mpu) -> [S3MpuPart] []
    list.clone(u.parts)

// How many parts have been uploaded, and how many there are.
pub fn progress_of(u: S3Mpu) -> (Int, Int) []
    (u.uploaded, list.len(u.parts))

// Whether this upload has parts stored in the bucket.
//
// The question a caller answers before deciding whether a failure needs
// cleaning up.  True from the moment `initiate` succeeded, because a
// zero-part upload is still an upload id that has to be aborted.
pub fn owes_abort(u: S3Mpu) -> Bool []
    u.upload_id != "" and u.state != S3MpuDone and u.state != S3MpuAborted

// The completion document's part list, sorted ascending.
//
// S3 refuses a completion whose parts are out of order with
// `InvalidPartOrder`, and the order a caller uploaded them in is not
// necessarily ascending — a parallel uploader finishes them in
// whatever order the network decided.
pub fn completion(u: S3Mpu) -> Result<[S3PartInfo], S3Fault> []
    var out: [S3PartInfo] = []
    var missing = 0
    for p in u.parts
        if p.etag == ""
            if missing == 0
                missing = p.number
        else
            out = list.concat(out, [S3PartInfo { part_number: p.number, etag: p.etag, size: p.length,
                                                 last_modified: "" }])
    if missing > 0
        Err(S3FaultService(400, S3ErrorDoc { code: S3InvalidPart,
                                             message: "part ${missing} has not been uploaded",
                                             resource: "", request_id: "", host_id: "" }))
    else
        Ok(out)
